    $authorized_macs = [];
    $authorized_ips = [];
    $expired_devices = [];

    $q = $db->query("SELECT d.id as did, d.mac_addr, d.ip_addr, s.id as sid, s.mb_limit, s.mb_used, s.time_limit_min, s.created_at FROM session s JOIN devices d ON d.id=s.device_id");
    
    $now = time();
    while($row = $q->fetchArray(SQLITE3_ASSOC)) {
        $mb_ok = ($row['mb_limit'] > 0 && floatval($row['mb_used']) < floatval($row['mb_limit']));
        $created = is_numeric($row['created_at']) ? (int)$row['created_at'] : strtotime($row['created_at']);
        $time_ok = ($row['time_limit_min'] > 0 && ($now - $created) < ($row['time_limit_min'] * 60));

        if ($mb_ok || $time_ok) {
            $authorized_macs[] = strtoupper($row['mac_addr']);
            $authorized_ips[] = $row['ip_addr'];
        } else {
            // GO SIGNAL: Expiry detected. 
            $expired_devices[] = ['ip' => $row['ip_addr'], 'mac' => strtoupper($row['mac_addr'])];
        }
    }

    // TRIGGER CLEANUP FOR EXPIRED SESSIONS
    foreach ($expired_devices as $dev) {
        $ipt = new Iptables($dev['ip']);
        $ipt->mac = $dev['mac'];
        $ipt->rem_client(); 
    }

    // RESTORATION (Positive Enforcement)
    // If a valid user is missing from the firewall (e.g. after service restart), re-add them.
    foreach ($authorized_ips as $idx => $ip) {
        $mac = $authorized_macs[$idx];
        $ipt = new Iptables($ip);
        $ipt->mac = $mac;
        if (!$ipt->connected()) {
            $ipt->add_client();
        }
    }

