    // ACCOUNTING
    $acc = shell_exec("sudo iptables -nvxL FORWARD --line-numbers");
    if ($acc) {
        foreach(explode("\n", trim($acc)) as $line) {
            if (preg_match('/^\s*(\d+)\s+\d+\s+(\d+)\s+ACCEPT\s+.*?\s+eth1\s+.*?\s+([\d\.]+)\s+/', $line, $m)) {
                $bytes = (float)$m[2]; $ip_src = $m[3];
                if ($bytes > 100000 && $ip_src !== '10.0.0.1') {
                    $mb_used = $bytes / 1000000;
